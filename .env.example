PORT=3000
# Internal URL of the existing self-hosted Supabase Kong service.
SUPABASE_URL=
# Existing anon API key used by Kong. Kept on the server with the write token.
SUPABASE_ANON_KEY=
# Server-only JWT with the insert-only varcun_quote_writer role.
# Never prefix this with VITE_ or place it in browser code.
SUPABASE_WRITE_KEY=
# Restricted JWT for varcun_admin_backend. Never a Supabase service_role key.
SUPABASE_ADMIN_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_HTTPS=false
